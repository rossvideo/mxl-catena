FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    dmidecode \
    ca-certificates \
    tar \
    bash \
    sudo \
  && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/MediaIO /tmp/media

ADD Indigo-*.tar.gz /opt/MediaIO/
COPY licensing.ini /opt/MediaIO/workspace/.metadata/.plugins/com.rossvideo.common.rwp/licensing.ini
COPY endpoint_indigo.sh /endpoint.sh
WORKDIR /opt/MediaIO
RUN sudo mkdir -p "/C:" /data && \
    sudo ln -s /data "/C:/data" && \
    sudo chown -R 1000:1000 "/C:" /data

ENTRYPOINT [ "/endpoint.sh" ]